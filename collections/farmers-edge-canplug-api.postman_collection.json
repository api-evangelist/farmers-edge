          "request": {
            "name": "canplug imeicanplug list",
            "description": {
              "content": "Get a canplug through IMEI.  This should ONLY be used during the provisioning process.  A\nCanPlug's IMEI may change after the original manufacturer spreadsheet is loaded in.  In such\na case, we aren't searching by the IMEI property, but by the original _imei value.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "canplug",
                "imeicanplug",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "imei",
                  "value": "<string>",
                  "description": "(Required) Filter canplug by the imei id."
                }
              ],
              "variable": []
            },
